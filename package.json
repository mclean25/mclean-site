{
  "name": "mclean-site",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check:infra": "tsc -p tsconfig.infra.json",
    "plan": "pnpm build && node scripts/alchemy.mjs plan",
    "deploy": "pnpm build && node scripts/alchemy.mjs deploy",
    "plan:prod": "pnpm build && node scripts/alchemy.mjs plan --stage prod",
    "deploy:prod": "pnpm build && node scripts/alchemy.mjs deploy --stage prod",
    "plan:artifacts": "node scripts/alchemy.mjs plan infra/artifacts.run.ts --stage prod",
    "deploy:artifacts": "node scripts/alchemy.mjs deploy infra/artifacts.run.ts --stage prod",
    "test:artifacts": "node artifacts/worker.test.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/sitemap": "^3.7.6",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@effect/platform-node": "4.1.5",
    "@tailwindcss/typography": "^0.5.20",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.5",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "wrangler": "^4.168.0"
  }
}

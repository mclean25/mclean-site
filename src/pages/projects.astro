---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectItem from "../components/ProjectItem.astro";

const projects = [
  {
    title: "wt",
    url: "https://github.com/micthiesen/wt",
    description:
      "A terminal UI for managing git worktrees, pull requests, and AI coding agents in one place",
  },
  {
    title: "workoutintervals.com",
    url: "https://workoutintervals.com",
    description:
      "A dead simple app I made for my fiancé that has configurable workout timers you can run",
  },
  {
    title: "Review Corral",
    url: "https://reviewcorral.com",
    description:
      "A Slack & Github bot made to handle pull-request notifictions for small engineering teams much more efficiently",
  },
  {
    title: "Tadu",
    url: "https://taduapp.com",
    description:
      "An iOS app (formerly Prioritizer) that sorts your to-do list by asking a few quick \"this or that\" questions, so you always know what to do first",
  },
];
---

<BaseLayout title="Projects">
  <div class="flex flex-col">
    <div class="space-y-2">
      <p>Here's some personal projects I've worked on:</p>
      <ul class="space-y-4 mt-8">
        {
          projects.map((project) => (
            <ProjectItem
              title={project.title}
              url={project.url}
              description={project.description}
            />
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>
